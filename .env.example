# Manga Gateway — example environment for docker compose.
#
# Copy to `.env` (git-ignored) and uncomment what you need:
#     cp .env.example .env
# App knobs are GATEWAY_-prefixed env vars (see src/manga_gateway/config.py).
# Precedence: env > TOML > default. The compose base file loads .env optionally,
# so the gateway also runs with NONE of these set (the image bakes safe defaults).
# The MANGARR_*_DIR vars below are read by docker-compose.yml (host mount paths),
# NOT by the app.
#
# ─────────────────────────────────────────────────────────────────────────────
# HOST DATA DIRECTORIES (docker-compose volume mounts; optional).
# Unset (default) → Docker NAMED volumes (gateway-state / gateway-output) — works
# on any host, including the Windows dev box. Set these to bind specific HOST
# directories instead (e.g. on a Linux server):
#   MANGARR_STATE_DIR     → /state      : config.toml + auto-generated API key,
#                                          gateway.db, cloudflare-userdata
#   MANGARR_DOWNLOADS_DIR → /data/manga : packaged CBZ output
# The container runs NON-ROOT (uid 10001), so a bound host dir MUST be writable by
# that uid or first-run config/key generation fails. On the server, once:
#   sudo mkdir -p /opt/mangarrgateway /mnt/mediatrial/mangarr_dl
#   sudo chown -R 10001:10001 /opt/mangarrgateway /mnt/mediatrial/mangarr_dl
#MANGARR_STATE_DIR=/opt/mangarrgateway
#MANGARR_DOWNLOADS_DIR=/mnt/mediatrial/mangarr_dl
# ─────────────────────────────────────────────────────────────────────────────
#
# ─────────────────────────────────────────────────────────────────────────────
# API KEY — DO NOT SET HERE.
# The API key is AUTO-GENERATED into the state volume's config.toml on first run
# (/state/config.toml) and logged once. Read it from there to authenticate
# (X-Api-Key header). GATEWAY_API_KEY is intentionally IGNORED (D-01) — setting
# it has no effect. Never put a real key in this file or commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudflare / anti-bot engine ─────────────────────────────────────────────
# Headless vs headed. The IMAGE DEFAULT is now false (HEADED Chromium under Xvfb).
# As of 2026-06-07 comix.to's Cloudflare fingerprints/blocks the headless Chromium
# UA ("HeadlessChrome") even from a residential IP — a headless solve no longer
# earns cf_clearance and comix /recent + /search 403 (debug comix-recent-403).
# Headed clears CF on every host (residential + datacenter); xvfb + fonts are
# ALREADY in the image, so headed works with NO image change. Only set this to true
# if you are NOT using comix and want to skip the xvfb display on a residential IP.
#GATEWAY_CLOUDFLARE_HEADLESS=false

# Engine. patchright (Chromium, default) runs Comix /search candidates in
# parallel. camoufox (Firefox) is the opt-in fallback for fingerprint-flagged
# hosts — but it is NOT baked into the image (LD-1); an operator using it must
# `camoufox fetch` at runtime AND pin GATEWAY_CLOUDFLARE_FETCH_CONCURRENCY=1
# (camoufox cannot run parallel — the app fails fast at startup otherwise, #64).
#GATEWAY_CLOUDFLARE_ENGINE=patchright

# Parallel browser navigations per /search. Default 3 (safe ONLY with
# engine=patchright). MUST be 1 when engine=camoufox.
#GATEWAY_CLOUDFLARE_FETCH_CONCURRENCY=3

# Eager-warm cold-start retry (#153). On a fresh container deploy the first CF
# warm occasionally fails fast (cold-profile/launch race) even though an on-demand
# warm works seconds later. The startup warm retries each source this many times
# (linear backoff = retry-seconds * attempt) BEFORE disabling it. 1 = no retry.
#GATEWAY_CLOUDFLARE_WARM_ATTEMPTS=3
#GATEWAY_CLOUDFLARE_WARM_RETRY_SECONDS=2.0

# ── Single static residential proxy (PROXY-01, issue #65) ────────────────────
# Route both the stealth browser and the httpx image-fetch through one proxy so
# cf_clearance (IP-bound) and image fetches share an egress IP. An alternative to
# headed+Xvfb on a datacenter host.
#GATEWAY_CLOUDFLARE_PROXY_SERVER=http://host:port
#GATEWAY_CLOUDFLARE_PROXY_USERNAME=proxy-username
# SECRET — env-only. NEVER commit a real value; leave it in your local .env only.
#GATEWAY_CLOUDFLARE_PROXY_PASSWORD=

# ── Android-WebView Cloudflare solver (Phase 10 — mangadot + kagane) ─────────
# mangadot.net + kagane.to serve a STRICT Cloudflare Turnstile that NO desktop
# browser automation clears from Linux (a render-consistency catch-22). A REAL
# Android WebView is a trusted fingerprint class that clears it — provided by the
# `redroid` + `android-solver` sidecars in docker-compose.yml. The gateway reaches
# the sidecar over the docker-internal network ONLY; the Android machinery stays
# out of the gateway process (R1). See README "Android-WebView Cloudflare solver".
#
# HOST PREREQUISITE: redroid needs the host kernel's `binder_linux`/`ashmem_linux`
# modules loaded + persisted (`/etc/modules-load.d/redroid.conf`) and the host
# iGPU exposed at `/dev/dri`. SHARED EGRESS IP: redroid + the gateway httpx MUST
# egress the SAME public IP (cf_clearance is IP-bound). Both knobs below default
# safely (URL unset ⇒ mangadot/kagane boot disabled, gateway still runs).
#
# The sidecar URL (docker-internal service name + port). compose sets this; only
# override for a non-default port/host.
#GATEWAY_ANDROID_SOLVER_URL=http://android-solver:8080
# SECRET — env-only. The sidecar's control-API key (X-Solver-Key). This value MUST
# match the sidecar's SOLVER_API_KEY; compose wires BOTH from this one .env value.
# Never commit a real value; leave it in your local .env only.
#GATEWAY_ANDROID_SOLVER_API_KEY=
# Gateway->sidecar client timeout (seconds). An Android WebView solve (force-stop +
# load + dynamic tap + cf_clearance poll) is slower than a desktop solve. This MUST
# EXCEED the sidecar's own per-solve cap (SOLVER_SOLVE_TIMEOUT_S, default 120) +
# margin, else the gateway abandons + re-fires a solve the sidecar would complete,
# thrashing the single redroid. Default 180 (= the 120 cap + 60 margin) is safe out
# of the box; raise it (e.g. 300) if you raise SOLVER_SOLVE_TIMEOUT_S.
#GATEWAY_ANDROID_SOLVER_TIMEOUT_S=180
#
# OPT-IN to the android sidecars. redroid + android-solver are gated behind the
# `android` compose profile, so a bare `docker compose up` runs the gateway ALONE
# (works with no .env, exposes no extra ports). Set this to start the full Android
# stack with your normal `docker compose -f docker-compose.yml up` command (it goes
# WITH GATEWAY_ANDROID_SOLVER_API_KEY above — the sidecar fails fast without a key).
# Equivalent to passing `--profile android` on the CLI.
#COMPOSE_PROFILES=android

# ── Source enable/disable (GATEWAY_DISABLED_SOURCES) ─────────────────────────
# Comma-separated source keys to SKIP registering at startup. On the DEPLOY, once
# the redroid + android-solver sidecars are up (and binder modules loaded), DROP
# `mangadot,kagane` from this list — the Android backend clears their Cloudflare,
# so they can be re-enabled. Keep them disabled on hosts WITHOUT the sidecars
# (e.g. the Windows dev box / CI — no binder kernel module).
#GATEWAY_DISABLED_SOURCES=kagane,mangadot

# ── Observability & metrics (Phase 8) ────────────────────────────────────────
# All optional — the image bakes the defaults shown. env > TOML > default.

# Structured-logging knobs (§Q3). log_dir holds the rotating gateway.jsonl;
# /state exists in the image but logs/ may not (created at startup). max_bytes /
# backup_count drive the RotatingFileHandler (each ≥1).
#GATEWAY_LOG_LEVEL=INFO
#GATEWAY_LOG_DIR=/state/logs
#GATEWAY_LOG_MAX_BYTES=10000000
#GATEWAY_LOG_BACKUP_COUNT=5

# Admin-metrics CORS allow-list (§Q2). DEFAULT-DENY: unset → no cross-origin
# access and the CORS middleware is not even added. A JSON list when set, e.g.
# to let a Vite dashboard on :5173 call /admin/metrics/v1/*:
#GATEWAY_METRICS_CORS_ORIGINS=["http://localhost:5173"]

# In-memory ring sizes for the metrics store (§Q4). Each bounds a deque (≥1):
#GATEWAY_METRICS_RECENT_RING=500
#GATEWAY_METRICS_FAILURES_RING=200
#GATEWAY_METRICS_SLOW_RING=200

# Snapshot-loop cadence in seconds (§Q4) — also the worst-case loss-on-crash
# window for persisted rollups (≥1).
#GATEWAY_METRICS_SNAPSHOT_INTERVAL_S=45

# "Slow" admission factor (§Q4): a request is slow when
# duration_ms > max(slow_factor*avg, p95) per rollup. A float > 0.
#GATEWAY_METRICS_SLOW_FACTOR=3.0

# Metrics snapshot DB path — a SEPARATE sqlite file from the job store's
# gateway.db so the two never contend.
#GATEWAY_METRICS_DB_PATH=/state/metrics.db

# ── Search-result / chapter-link caching (Phase 9) ───────────────────────────
# The source-agnostic enumeration cache. Defaults shown are also the baked
# image defaults; these are listed active (uncommented) so the documented
# values are explicit. env > TOML > default.
#
# Kill-switch (D-08), default ON. Set to 0/false to disable caching entirely
# (fall back to pre-Phase-9 behavior) while debugging stale/wrong results.
GATEWAY_ENUM_CACHE_ENABLED=true
# Max cached series enumerations (≥1). Caps cache memory (D-07).
GATEWAY_ENUM_CACHE_MAXSIZE=512
# Cache TTL in seconds; default 1800 (30 min). MUST stay ≤ 3600 (the 60-min
# downloadHandle TTL) — the gateway fails fast at startup otherwise (D-09).
GATEWAY_ENUM_CACHE_TTL_SECONDS=1800
