# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual env / uv
.venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.nox/
.hypothesis/

# Local runtime config (bears the auto-generated API key — D-01/D-10)
config.toml

# Local docker-compose env (operator knobs incl. the proxy SECRET, #65). The
# committed template is .env.example; a real .env must NEVER be committed.
.env

# SQLite job store (runtime persistence — PLAT-03) + WAL/SHM sidecars.
# Scoped to the runtime DB only so unrelated *.db fixtures aren't ignored (CR).
gateway.db*

# Patchright persistent-context dir holding cf_clearance (D-34) — runtime artifact,
# never committed (T-04-03). The committed D-44 decrypt fixtures stay tracked.
# The default name is config.cloudflare_user_data_dir ("cloudflare-userdata"); the
# legacy "comix-userdata" entry remains for repos that were initialized before the
# 04-04 rename.
cloudflare-userdata/
# Per-engine / per-experiment persistent-context dirs (e.g. cloudflare-userdata-patchright,
# cloudflare-userdata-patchright-proxy-exp6) ALSO hold cf_clearance — same T-04-03 rule.
cloudflare-userdata-*/
comix-userdata/

# Live-smoke (pytest -m live) runtime breadcrumb. The REAL D-44 *.bin/*.plain
# ciphertext+plaintext fixtures under tests/fixtures/comix/ STAY tracked — only the
# transient capture note the recorder drops is ignored.
tests/fixtures/comix/CAPTURE_NOTES.txt

# Throwaway recon output (scripts/comix_recon.py) — network logs, JS dumps, DOM
# snapshots used to pin RESEARCH Open Q1/Q3 and the D-44 cipher pair. Never committed.
_recon_out/
_e2e_out/

# Nightly live-smoke JUnit artifact written by `uv run nox -s live` (Phase 5
# D-63). Transient — uploaded as a CI artifact in the nightly workflow, never
# committed.
junit.xml
local-repro-*.log

# Diagnostic-only harness for the comix-parallel-page-contention / comix-parallel-engine-probe
# debug sessions (EXP-1..EXP-6, incl. the EXP-6 --proxy-server extension).
# Not production code; lives in tree so it can be re-run later without polluting git.
scripts/diagnose_comix_parallel_contention.py
# End-to-end results-path harness for comix-parallel-engine-probe EXP-5 (re-enabled fan-out).
scripts/exp5_comix_parallel_search_results.py

# Diagnostic-only harness for the cf-warm-burst-timeout debug session.
# Not production code; lives in tree so it can be re-run later without polluting git.
scripts/diagnose_cf_warm_burst.py

# Scratch dir used by diagnose_cf_warm_burst.py for per-warm user_data_dirs.
.planning/debug/_cf_warm_burst_scratch/

# Per-test scratch output from the cf-warm-burst diagnostic harness.
.planning/debug/cf-warm-burst-timeout-harness-stdout.log

# Diagnostic-only harnesses for the cf-warm-cliff-followup debug session.
# Not production code; live in tree so they can be re-run later.
scripts/diagnose_cf_cookie_reuse.py
scripts/diagnose_subprocess_leak.py
.planning/debug/_cf_cookie_reuse_scratch/
.planning/debug/_cf_subprocess_leak_scratch/
.planning/debug/cf-cookie-reuse-evidence.log
.planning/debug/cf-subprocess-leak-evidence.log

proxies.txt